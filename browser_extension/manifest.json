{
  "manifest_version": 3,
  "name": "Kungens Trav — Tipshämtare",
  "version": "1.0.0",
  "description": "Hämtar travtips & kusk-/tränarintervjuer från dina inloggade sajter och skickar till Kungens Trav. Inga lösenord lagras — allt körs i din egen webbläsare.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "https://travagentroi-production.up.railway.app/*",
    "*://*.aftonbladet.se/*",
    "*://*.sportbladet.se/*",
    "*://*.expressen.se/*",
    "*://*.travronden.se/*",
    "*://*.kungenstrav.se/*",
    "*://*.travfakta.se/*",
    "*://*.atg.se/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kungens Trav — Hämta tips"
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": [
        "*://*.aftonbladet.se/*",
        "*://*.sportbladet.se/*",
        "*://*.expressen.se/*",
        "*://*.travronden.se/*",
        "*://*.kungenstrav.se/*",
        "*://*.travfakta.se/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
